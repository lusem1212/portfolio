---
// Works section — horizontal scroll gallery of interior design projects
const projects = [
  {
    title: '柳畔听澜 · 02户型',
    subtitle: '现代东方 · 220㎡',
    tags: ['住宅', '现代东方', '大平层'],
    image: null,
  },
  {
    title: '惠泽园 F1-502',
    subtitle: '极简主义 · 140㎡',
    tags: ['住宅', '极简', '公寓'],
    image: null,
  },
  {
    title: '红星天铂 55-03',
    subtitle: '轻奢都会 · 180㎡',
    tags: ['住宅', '轻奢', '复式'],
    image: null,
  },
  {
    title: '天城国际 · 样板间',
    subtitle: '当代雅致 · 260㎡',
    tags: ['商业', '样板间', '大平层'],
    image: null,
  },
  {
    title: '隐山 · 茶空间',
    subtitle: '禅意美学 · 80㎡',
    tags: ['商业', '茶空间', '东方'],
    image: null,
  },
  {
    title: '云栖 · 度假别墅',
    subtitle: '自然共生 · 450㎡',
    tags: ['住宅', '别墅', '自然'],
    image: null,
  },
];
---

<section id="works" data-section="works" class="section-container flex-col justify-center py-24">
  <div class="w-full px-8 md:px-16 lg:px-24 mb-16">
    <p class="text-xs tracking-widest uppercase text-subtle mb-4">Selected Projects</p>
    <h2 class="font-display text-4xl md:text-5xl font-semibold tracking-tight">作品</h2>
  </div>

  <!-- Horizontal scroll gallery -->
  <div class="scroll-gallery px-8 md:px-16 lg:px-24 w-full">
    {
      projects.map((project, i) => (
        <div
          class="group relative w-[320px] md:w-[420px] h-[480px] flex flex-col justify-end cursor-pointer"
        >
          <!-- Placeholder image -->
          <div class="absolute inset-0 bg-surface-raised border border-white/5 overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center p-6">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-white/5 flex items-center justify-center">
                  <svg class="w-6 h-6 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <p class="text-xs text-white/30 tracking-wider uppercase">{project.subtitle}</p>
              </div>
            </div>
          </div>

          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent" />

          <!-- Project info -->
          <div class="relative z-10 p-6 pb-8">
            <!-- Tags -->
            <div class="flex gap-2 mb-3">
              {project.tags.map((tag) => (
                <span class="text-[10px] tracking-widest uppercase gold-accent opacity-80">{tag}</span>
              ))}
            </div>
            <h3 class="font-display text-2xl md:text-3xl font-medium leading-tight mb-1">{project.title}</h3>
            <p class="text-xs tracking-wider text-subtle">{project.subtitle}</p>
          </div>

          <!-- Hover line -->
          <div class="absolute bottom-0 left-6 right-6 h-[1px] bg-gold/30 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />
        </div>
      ))
    }
  </div>

  <!-- More hint -->
  <div class="w-full px-8 md:px-16 lg:px-24 mt-10 flex items-center gap-3">
    <span class="text-xs tracking-widest uppercase text-subtle">drag or scroll to explore</span>
    <span class="text-lg text-gold">&rarr;</span>
  </div>
</section>
