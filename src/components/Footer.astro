---
// Footer
---

<footer class="relative bg-surface-DEFAULT border-t border-white/5 px-8 md:px-16 lg:px-24 py-16">
  <div class="max-w-6xl mx-auto">
    <!-- Top row: Logo + Nav -->
    <div class="flex flex-col md:flex-row justify-between gap-12 mb-16">
      <!-- Brand -->
      <div>
        <p class="font-display text-2xl font-semibold tracking-tight mb-2">LI</p>
        <p class="text-xs tracking-widest uppercase gold-accent">Design Studio</p>
      </div>

      <!-- Nav columns -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-16">
        <div>
          <p class="text-xs tracking-widest uppercase text-subtle mb-4">Projects</p>
          <ul class="space-y-2">
            <li><a href="#works" class="text-sm font-light text-white/60 hover:text-gold transition-colors duration-300">柳畔听澜</a></li>
            <li><a href="#works" class="text-sm font-light text-white/60 hover:text-gold transition-colors duration-300">惠泽园</a></li>
            <li><a href="#works" class="text-sm font-light text-white/60 hover:text-gold transition-colors duration-300">红星天铂</a></li>
            <li><a href="#works" class="text-sm font-light text-white/60 hover:text-gold transition-colors duration-300">全部作品 &rarr;</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs tracking-widest uppercase text-subtle mb-4">Services</p>
          <ul class="space-y-2">
            <li><span class="text-sm font-light text-white/60">住宅设计</span></li>
            <li><span class="text-sm font-light text-white/60">商业空间</span></li>
            <li><span class="text-sm font-light text-white/60">软装陈设</span></li>
            <li><span class="text-sm font-light text-white/60">设计顾问</span></li>
          </ul>
        </div>
        <div>
          <p class="text-xs tracking-widest uppercase text-subtle mb-4">Contact</p>
          <ul class="space-y-2">
            <li><span class="text-sm font-light text-white/60">hello@lidesign.studio</span></li>
            <li><span class="text-sm font-light text-white/60">WeChat: LI_Design</span></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pt-8 border-t border-white/5">
      <p class="text-xs text-white/30">&copy; 2026 LI Design Studio. All rights reserved.</p>
      <p class="text-xs text-white/20 font-light italic">
        用空间诉说故事
      </p>
    </div>
  </div>
</footer>
